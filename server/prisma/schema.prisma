generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              Int      @id @default(autoincrement())
  isVerified      Boolean  @default(false)
  verifiedCode    Int?
  verifiedExpires DateTime?
  email           String   @unique
  name            String
  passwordHash    String
  role            Role     @default(USER)
  status          String
  image           String
}
